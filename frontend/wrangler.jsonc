{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flexcrm",
  "compatibility_date": "2024-12-01",
  // Worker entry: serves the SPA via the ASSETS binding and runs the cron
  // keep-alive (scheduled handler). Static assets are still served first by the
  // platform, so this doesn't change SPA delivery.
  "main": "worker/index.js",
  // Workers with Static Assets — serves the Vite build output from ./dist.
  // The SPA fallback replaces the Pages-only `public/_redirects` behavior:
  // any unmatched route serves index.html so React Router can take over.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  // Crons (UTC):
  //  - 30 3 * * *   : daily 03:30 UTC (~09:00 IST) — reminders + follow-ups +
  //                   Meta token refresh + Meta lead-sync + 99acres reconcile + Google Sheet sync
  //                   + the nightly maintenance jobs (customer health, HR scorecards, archival).
  //  - 15 11 * * *  : daily 11:15 UTC (16:45 IST) — Meta lead-sync + 99acres reconcile + Google Sheet sync.
  //  - 30 15 * * *  : daily 15:30 UTC (~21:00 IST) — Meta lead-sync + 99acres reconcile + Google Sheet sync.
  // => The lead-pull trio (Meta lead-sync, 99acres reconcile, Google Sheet sync) runs on EVERY cron
  //    (now 3x daily: 09:00, 16:45, 21:00 IST); token refresh + reminders + maintenance run ONCE daily
  //    (only on the 03:30 cron). The scheduled() handler branches on event.cron (worker/index.js).
  // NOTE: the old */4 keep-alive ping was REMOVED — on Neon's free tier it kept
  // the compute awake 24/7 and burned the monthly compute allowance, which
  // hard-suspends the DB for the rest of the cycle (total outage). We now let
  // Neon auto-suspend when idle; the first request after idle wakes it (~2-5s,
  // covered by the client's retry). The lead-pull crons wake Neon 3x a day, which
  // is still free-tier-safe. Re-add a keep-alive only on a paid plan.
  "triggers": {
    "crons": ["30 3 * * *", "15 11 * * *", "30 15 * * *"]
  },
  "vars": {
    "REMINDERS_URL": "https://flexcrm-backend-539170436218.asia-south1.run.app/api/v1/cron/registration-reminders",
    "FOLLOWUP_URL": "https://flexcrm-backend-539170436218.asia-south1.run.app/api/v1/cron/followup-reminders",
    "META_SYNC_URL": "https://flexcrm-backend-539170436218.asia-south1.run.app/api/v1/cron/meta-lead-sync",
    "META_TOKEN_REFRESH_URL": "https://flexcrm-backend-539170436218.asia-south1.run.app/api/v1/cron/meta-token-refresh",
    "LEAD_SOURCE_RECONCILE_URL": "https://flexcrm-backend-539170436218.asia-south1.run.app/api/v1/cron/lead-source-reconcile",
    "GOOGLE_SHEET_SYNC_URL": "https://flexcrm-backend-539170436218.asia-south1.run.app/api/v1/cron/google-sheet-sync",
    "CUSTOMER_HEALTH_URL": "https://flexcrm-backend-539170436218.asia-south1.run.app/api/v1/cron/customer-health",
    "SCORECARD_URL": "https://flexcrm-backend-539170436218.asia-south1.run.app/api/v1/cron/scorecard-compute",
    "ARCHIVE_URL": "https://flexcrm-backend-539170436218.asia-south1.run.app/api/v1/cron/archive"
  }
  // NOTE: CRON_SECRET is a Worker *secret*, not a var — set it with
  // `npx wrangler secret put CRON_SECRET` (must match the backend CRON_SECRET).
}
