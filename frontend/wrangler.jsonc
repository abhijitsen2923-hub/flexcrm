{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flexcrm",
  "compatibility_date": "2024-12-01",
  // Worker entry: serves the SPA via the ASSETS binding and runs the cron
  // keep-alive (scheduled handler). Static assets are still served first by the
  // platform, so this doesn't change SPA delivery.
  "main": "worker/index.js",
  // Workers with Static Assets — serves the Vite build output from ./dist.
  // The SPA fallback replaces the Pages-only `public/_redirects` behavior:
  // any unmatched route serves index.html so React Router can take over.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  // Crons (UTC):
  //  - 30 3 * * *   : daily 03:30 UTC (~09:00 IST) — reminder dispatch.
  // NOTE: the old */4 keep-alive ping was REMOVED — on Neon's free tier it kept
  // the compute awake 24/7 and burned the monthly compute allowance, which
  // hard-suspends the DB for the rest of the cycle (total outage). We now let
  // Neon auto-suspend when idle; the first request after idle wakes it (~2-5s,
  // covered by the client's retry). Re-add a keep-alive only on a paid Neon plan.
  // The scheduled() handler branches on event.cron (worker/index.js).
  "triggers": {
    "crons": ["30 3 * * *"]
  },
  "vars": {
    "REMINDERS_URL": "https://flexcrm-backend-539170436218.asia-south1.run.app/api/v1/cron/registration-reminders",
    "FOLLOWUP_URL": "https://flexcrm-backend-539170436218.asia-south1.run.app/api/v1/cron/followup-reminders"
  }
  // NOTE: CRON_SECRET is a Worker *secret*, not a var — set it with
  // `npx wrangler secret put CRON_SECRET` (must match the backend CRON_SECRET).
}
