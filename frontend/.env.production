# Production build flags. Enable every platform-level module so that per-org
# module access is controlled entirely by the Platform Admin UI.
# See src/config/features.ts: mergeModules(orgModules) = FEATURES[k] && orgModules[k]
# — a module shows only when BOTH the platform flag (here) and the org toggle are on.
# Vite loads this file automatically during `vite build` (production mode).
# API/WS base URLs are NOT set here; they come from the Cloudflare build environment.
VITE_FEATURE_DEALS_ENABLED=true
VITE_FEATURE_TASKS_ENABLED=true
VITE_FEATURE_ACTIVITIES_ENABLED=true
VITE_FEATURE_FINANCE_ENABLED=true
VITE_FEATURE_HR_ENABLED=true
VITE_FEATURE_INVENTORY_ENABLED=true
VITE_FEATURE_BOOKINGS_ENABLED=true
VITE_FEATURE_SITE_VISITS_ENABLED=true
VITE_FEATURE_PROJECTS_ENABLED=true
# Drives BOTH meta_facebook and meta_instagram (src/config/features.ts) — the
# per-platform choice is the per-org admin toggle, not the build flag. Without
# this, /integrations is unroutable and the nav item never renders, no matter
# what the platform admin has granted.
VITE_FEATURE_META_LEADS_ENABLED=true
# 99acres inbound leads (push webhook). Platform flag; per-org access via the admin toggle.
# Without this, /integrations is unroutable for a 99acres-only org and the card never renders.
VITE_FEATURE_99ACRES_ENABLED=true
