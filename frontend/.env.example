# FlexCRM frontend environment variables
# Copy to `frontend/.env` and fill in. Only `VITE_*` keys are exposed to the bundle.

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1

# --- Feature flags --------------------------------------------------------
# Modules below are hidden from the UI until they're production-ready. Flip
# to `true` and rebuild to enable a module for end users. Backend endpoints
# stay reachable either way.
VITE_FEATURE_DEALS_ENABLED=false
VITE_FEATURE_TASKS_ENABLED=false
VITE_FEATURE_ACTIVITIES_ENABLED=false
VITE_FEATURE_FINANCE_ENABLED=false
VITE_FEATURE_HR_ENABLED=false
