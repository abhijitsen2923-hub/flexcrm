# =============================================================================
# FlexCRM — environment variables
# Copy to `.env` at the same level the backend is launched from, fill values.
# Loaded automatically by pydantic-settings (`backend/app/core/config.py`).
# Frontend variables (VITE_*) must live in `frontend/.env`.
# =============================================================================

# --- App ---
PROJECT_NAME=FlexCRM API
ENVIRONMENT=local                       # local | test | staging | production
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true

# --- Docker host port mappings ---
# Defaults avoid collisions with a locally-installed Postgres/Redis. Set these
# to 5432 / 6379 if those ports are free on your host.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
FRONTEND_HOST_PORT=5173

# --- Frontend (Vite) — baked into the bundle at startup ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1

# --- Database ---
# Async URL is used by the application; sync URL is used by Alembic migrations.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crm
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm
SQLALCHEMY_ECHO=false

# --- JWT ---
# REQUIRED: replace with random strings of >=16 chars in any non-local env.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-access-secret-please-rotate
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret-please-rotate
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7

# --- Cache / Redis ---
# REQUIRED for multi-worker / multi-replica deployment (rate-limit & cache
# correctness). If unset or unreachable the app falls back to per-process
# in-memory state — safe only for a single Uvicorn worker.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=120

# --- CORS ---
# Comma-separated list of allowed origins for the SPA.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SMTP (optional) ---
# If SMTP_HOST is empty the email service logs to stdout instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@flexcrm.local
SMTP_USE_TLS=true

# --- WebSocket ---
WEBSOCKET_PING_INTERVAL_SECONDS=20

# --- Archival job (soft-delete cleanup) ---
# Days a soft-deleted row is retained before being hard-deleted by the
# archival task. Set to 0 to disable archival.
ARCHIVAL_RETENTION_DAYS=90

# --- Platform admin bootstrap (optional) ---
# Set these once to automatically create/promote a platform admin on app startup.
# Idempotent — safe to leave set after first run; no duplicate is ever created.
# Leave blank to skip (normal users are created via /auth/register instead).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- Transactional email (Resend) ---
# The email service is Resend-only; the SMTP_* block above is legacy and unused.
# Unset RESEND_API_KEY => emails are logged and skipped, never sent.
RESEND_API_KEY=
EMAIL_FROM=FlexCRM <onboarding@resend.dev>
# Public base URL of the SPA — used to build links in emails and as the OAuth
# return target for the Meta connect flow.
APP_BASE_URL=https://flexcrm.example.com

# --- Machine-triggered cron endpoints (/api/v1/cron/*) ---
# Shared secret sent as `X-Cron-Key` by the Cloudflare Worker scheduler. Must
# match the Worker secret of the same name (`npx wrangler secret put CRON_SECRET`).
# Unset => every /cron/* endpoint returns 403, so it's inert by default.
CRON_SECRET=

# --- Object storage (S3-compatible: Backblaze B2 / Cloudflare R2 / AWS S3) ---
# Unset => file upload/download endpoints return a clean 503 and everything else
# keeps working. Buckets are private; downloads use short-lived presigned URLs.
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_TTL_SECONDS=3600

# --- Meta (Facebook/Instagram) Lead Ads integration ---
# Fernet keys encrypting tenant Meta tokens at rest, comma-separated. The FIRST
# key encrypts; all keys decrypt, so rotate by PREPENDING a new one. Unset =>
# the token vault is unconfigured and connecting returns 503.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
META_ENC_KEYS=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_OAUTH_REDIRECT_URI=
# Echoed back during the webhook handshake. Unset => GET /webhooks/meta 403s.
META_WEBHOOK_VERIFY_TOKEN=
# Facebook Login for Business configuration id. When set, the OAuth start URL
# uses config_id instead of an explicit scope list.
META_LOGIN_CONFIG_ID=

# --- ngrok tunnel (opt-in via `docker compose --profile tunnel up`) ---
# Exposes the local backend (port 8000) over HTTPS so a deployed frontend
# (e.g. Cloudflare Pages) or external collaborators can reach it.
# Get a token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
